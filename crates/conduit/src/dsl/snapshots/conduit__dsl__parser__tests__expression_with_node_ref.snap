            inputs: {
                "multiplier": Numeric {
                    direction: Input,
                    value: "4",
                },
            },
        },
        "name": NodeInstruct {
            identifier: "name",
            module: "module",
            inputs: {
                "width": Expression {
                    direction: Input,
                    value: BinaryOperation {
                        operation: Multiply,
