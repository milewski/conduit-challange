    {
        "name": NodeInstruct {
            identifier: "name",
            module: "module",
            inputs: {
                "property": Expression {
                    direction: Input,
                    value: BinaryOperation {
                        operation: Multiply,
                        left: BinaryOperation {
                            operation: Add,
                            left: Number(
                                "2",
                            ),
                            right: Number(
                                "3",
                            ),
                        },
                        right: Number(
                            "4",
                        ),
                    },
                },
            },
        },
    },
)
