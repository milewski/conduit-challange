nodes = { SOI ~ line_break* ~ ((anonymous_node | node) ~ line_break*)* ~ EOI }
node = { identifier ~ module ~ (shorthand | body) }
anonymous_node = { module ~ (shorthand | body) }

shorthand = { direction ~ value }

body = { "{" ~ line_break* ~ (parameter ~ line_break*)* ~ "}" }
parameter = { property ~ direction ~ value }

string = { "\"" ~ inner_string ~ "\"" }
inner_string = @{ char* }
char = _{
    !("\"" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
    | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}

number = @{
    "-"?
    ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*)
    ~ ("." ~ ASCII_DIGIT*)?
    ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}

boolean = { "true" | "false" }
relation = { identifier ~ "::" ~ property }

value = { string | boolean | "(" ~ expression ~ ")" | number | node | anonymous_node | relation | identifier }

expression = { numeric ~ (operation ~ numeric)* }
numeric = _{ number | relation | "(" ~ expression ~ ")" }

operation = _{ add | subtract | multiply | divide | power }
    add      = { "+" }
    subtract = { "-" }
    multiply = { "*" }
    divide   = { "/" }
    power    = { "^" }

direction = { "<-" | "->" }
identifier = @{ (ASCII_ALPHA | "_")+ }
module = ${ identifier ~ ("::" ~ property)? }
property = @{ (ASCII_ALPHA | ASCII_DIGIT | "_")+ }

line_break = _{ "\n" | "\r\n" | "\r" }
WHITESPACE = _{ " " | "\t" }