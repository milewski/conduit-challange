nodes = { SOI ~ NEWLINE* ~ ((input_def | pipeline_result | for_loop | anonymous_node | node) ~ NEWLINE*)* ~ EOI }
input_def = { "->" ~ identifier ~ ("<-" ~ value)? }
pipeline_result = { "<-" ~ value }

for_loop = { "for" ~ identifier ~ "in" ~ range ~ loop_body }
loop_body = { "{" ~ NEWLINE* ~ (node | anonymous_node | for_loop | NEWLINE)* ~ "}" }
range = { number ~ ".." ~ number }

node = { identifier ~ module ~ (shorthand | body) }
anonymous_node = { module ~ (shorthand | body) }

shorthand = { direction ~ value }

body = { "{" ~ NEWLINE* ~ (parameter ~ NEWLINE*)* ~ "}" }
parameter = { property? ~ direction ~ value }

string = ${ "\"" ~ (interpolation | string_content)* ~ "\"" }
string_content = @{ char+ }
interpolation = { "{" ~ interpolation_content ~ "}" }
interpolation_content = @{ (!"}" ~ ANY)* }

interpolation_expression = { SOI ~ expression ~ EOI }

char = _{
    !("\"" | "\\" | "{") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | "{")
    | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}

number = @{
    "-"?
    ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*)
    ~ ("." ~ ASCII_DIGIT* ~ !".")?
    ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}

boolean = { "true" | "false" }
relation = { identifier ~ "::" ~ property }
tuple = { "(" ~ NEWLINE* ~ value ~ ("," ~ NEWLINE* ~ value)+ ~ ","? ~ NEWLINE* ~ ")" }
array_map = { "[" ~ NEWLINE* ~ (node ~ NEWLINE*)* ~ "]" }

value = { string | boolean | tuple | "(" ~ expression ~ ")" | number | node | anonymous_node | relation | identifier | array_map }

expression = { numeric ~ (operation ~ numeric)* }
numeric = _{ number | string | relation | identifier | "(" ~ expression ~ ")" }

operation = _{ add | subtract | multiply | divide | power }
    add      = { "+" }
    subtract = { "-" }
    multiply = { "*" }
    divide   = { "/" }
    power    = { "^" }

direction = { "<-" | "->" }
identifier = @{ (ASCII_ALPHA | "_")+ }
module = ${ identifier ~ ("::" ~ property)? }
property = @{ (ASCII_ALPHA | ASCII_DIGIT | "_")+ }

WHITESPACE = _{ " " | "\t" }
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }
